rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function mine(uid) { return request.auth != null && request.auth.uid == uid; }
    function identifier(value) { return value is string && value.matches('^[A-Za-z0-9_:-]{1,128}$') && !(value in ['__proto__','constructor','prototype']); }
    function count(value) { return value is int && value >= 0 && value <= 1000000000; }
    function stamp(value) { return value is int && value >= 0 && value <= 9007199254740991; }
    function difficulty(value) { return value in ['easy','normal','hard','expert']; }
    function summary(d, playId) {
      return d.keys().hasAll(['playId','difficulty','misses','hintsUsed'])
        && d.keys().hasOnly(['playId','difficulty','misses','hintsUsed'])
        && identifier(playId) && d.playId == playId && difficulty(d.difficulty)
        && count(d.misses) && d.hintsUsed is int && d.hintsUsed >= 0 && d.hintsUsed <= 3;
    }
    function clearRecord(d, fingerprint) {
      return d.keys().hasAll(['boardFingerprint','playId','difficulty','misses','hintsUsed','completedAt'])
        && d.keys().hasOnly(['boardFingerprint','playId','difficulty','misses','hintsUsed','completedAt'])
        && identifier(fingerprint) && d.boardFingerprint == fingerprint && identifier(d.playId)
        && difficulty(d.difficulty) && count(d.misses) && d.hintsUsed is int
        && d.hintsUsed >= 0 && d.hintsUsed <= 3 && stamp(d.completedAt);
    }
    function settingMetadata(v) {
      return v is map && v.keys().hasOnly(['value','updatedAt','deviceId'])
        && stamp(v.updatedAt) && identifier(v.deviceId);
    }
    function booleanSetting(v) {
      return settingMetadata(v) && v.value is bool;
    }
    function volumeSetting(v) {
      let value = v.value;
      return settingMetadata(v) && value is number && value >= 0 && value <= 1;
    }
    function settings(d) {
      return d.keys().hasAll(['bgmEnabled','sfxEnabled','bgmVolume','sfxVolume','reducedMotion'])
        && d.keys().hasOnly(['bgmEnabled','sfxEnabled','bgmVolume','sfxVolume','reducedMotion','arrowTheme','colorMode','showMistakes'])
        && booleanSetting(d.bgmEnabled) && booleanSetting(d.sfxEnabled)
        && volumeSetting(d.bgmVolume) && volumeSetting(d.sfxVolume) && booleanSetting(d.reducedMotion)
        && (!('arrowTheme' in d) || themeSetting(d.arrowTheme))
        && (!('colorMode' in d) || modeSetting(d.colorMode))
        && (!('showMistakes' in d) || booleanSetting(d.showMistakes));
    }
    function themeSetting(v) {
      return settingMetadata(v) && v.value in ['forest','ocean','grape','ember'];
    }
    function modeSetting(v) {
      return settingMetadata(v) && v.value in ['light','dark','system'];
    }
    function newer(a,b) {
      let at = a.updatedAt;
      let bt = b.updatedAt;
      // Called only for fields in affectedKeys; identical fields need no check.
      return at > bt || (at == bt && a.deviceId > b.deviceId);
    }
    function appearancePreserved(next,old,key) {
      // Legacy writes are valid until the setting exists; patches preserve it.
      // A legacy full replacement must never erase an already chosen appearance.
      return !(key in old) || (key in next && newer(next[key],old[key]));
    }
    function preferencesUpdate(next,old) {
      let changed = next.diff(old).affectedKeys();
      return settings(next)
        && (!('bgmEnabled' in changed) || newer(next.bgmEnabled,old.bgmEnabled))
        && (!('sfxEnabled' in changed) || newer(next.sfxEnabled,old.sfxEnabled))
        && (!('bgmVolume' in changed) || newer(next.bgmVolume,old.bgmVolume))
        && (!('sfxVolume' in changed) || newer(next.sfxVolume,old.sfxVolume))
        && (!('reducedMotion' in changed) || newer(next.reducedMotion,old.reducedMotion))
        && (!('arrowTheme' in changed) || appearancePreserved(next,old,'arrowTheme'))
        && (!('colorMode' in changed) || appearancePreserved(next,old,'colorMode'))
        && (!('showMistakes' in changed) || appearancePreserved(next,old,'showMistakes'));
    }
    match /users/{uid}/playSummaries/{playId} {
      allow read: if mine(uid);
      allow create: if mine(uid) && summary(request.resource.data,playId);
      allow update: if mine(uid) && summary(request.resource.data,playId)
        && request.resource.data.difficulty == resource.data.difficulty
        && request.resource.data.misses >= resource.data.misses
        && request.resource.data.hintsUsed >= resource.data.hintsUsed;
    }
    match /users/{uid}/clears/{fingerprint} {
      allow read: if mine(uid);
      allow create: if mine(uid) && clearRecord(request.resource.data,fingerprint);
      // The first accepted clear is immutable, including after response loss.
      allow update, delete: if false;
    }
    match /users/{uid}/preferences/app {
      allow read: if mine(uid);
      allow create: if mine(uid) && settings(request.resource.data);
      allow update: if mine(uid) && preferencesUpdate(request.resource.data,resource.data);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
